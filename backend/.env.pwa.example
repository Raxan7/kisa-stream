# Never commit actual credentials. Configure your hosting provider's secret manager.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR_NEON_HOST/DB?sslmode=require
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
ADMIN_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHARACTER_SECRET
ADMIN_DASHBOARD_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
BASE_URL=https://api.YOUR_DOMAIN
CORS_ORIGINS=https://YOUR_PAGES_PROJECT.pages.dev,https://YOUR_DOMAIN
DEMO_MODE=false
SEED_DEMO=false
# disabled is safest until ClickPesa merchant API spec is provided/tested.
PAYMENT_MODE=disabled
FREE_EPISODES=8
EPISODE_COST_COINS=10
TOKEN_PACK_TZS=1000
TOKEN_PACK_COINS=30
VIDEO_STORAGE=local
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
# Enable Embed View Token Authentication in Bunny dashboard, with same signing key.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
