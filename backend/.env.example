# Change both keys before exposing this service on a public network.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX
ADMIN_API_KEY=REPLACE_WITH_SEPARATE_RANDOM_64_CHAR_HEX
DATABASE_URL=sqlite:///./data/kisa.db
BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=
DEMO_MODE=false
DEMO_ADMIN_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
# 'demo' = explicitly simulated payments; 'clickpass' = external checkout adapter; 'play' = Google Play verified products.
PAYMENT_MODE=demo
CLICKPASS_API_URL=
CLICKPASS_API_KEY=
CLICKPASS_WEBHOOK_SECRET=
# Product ID configured in Play Console. API requires GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_PLAY_PACKAGE=com.example.kisastream
GOOGLE_PLAY_PRODUCT_ID=coins_30_tzs_1000
